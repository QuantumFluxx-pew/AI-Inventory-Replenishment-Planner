# Copy this file to .streamlit/secrets.toml for local runs
# (secrets.toml is ignored by git, so your key stays private).
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets instead.

GEMINI_API_KEY = "paste-your-key-from-aistudio.google.com"

# Optional: change the Gemini model without editing code.
# GEMINI_MODEL = "gemini-3.5-flash-lite"
